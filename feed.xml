---
layout: null
---
{%- assign posts = site.pages | where: "blog_post", true | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{% if posts.size > 0 %}{{ posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <title type="text">{{ site.title | xml_escape }}</title>
  <subtitle type="text">{{ site.description | xml_escape }}</subtitle>
  <author><name>Michael N. Arbel</name></author>
{% for post in posts %}
  <entry>
    <title type="text">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ post.url | absolute_url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
{% if post.summary %}    <summary type="html">{{ post.summary | markdownify | xml_escape }}</summary>
{% endif %}    <content type="html">{{ post.content | markdownify | xml_escape }}</content>
  </entry>
{% endfor %}
</feed>
