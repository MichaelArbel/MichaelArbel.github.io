---
layout: null
---
{%- assign pages = site.pages | sort: "url" -%}
{%- assign blog_posts = site.pages | where: "blog_post", true -%}
{%- assign excluded_urls = "/404.html|/feed.xml|/news-data/|/sitemap.xml" | split: "|" -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in pages %}
  {% assign is_empty_blog_index = false %}
  {% if page.url == "/blog/" and blog_posts.size == 0 %}{% assign is_empty_blog_index = true %}{% endif %}
  {% unless excluded_urls contains page.url or is_empty_blog_index %}
    {% unless page.url contains "/_pages/" %}
      {% if page.output != false and page.sitemap != false %}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
  </url>
      {% endif %}
    {% endunless %}
  {% endunless %}
{% endfor %}
</urlset>
